# Aplicacion
NODE_ENV=development
PORT=3000
TERCEROS_NAME=terceros

# Simulacion de caida de cada proveedor. Es el estimulo del experimento, no una
# tactica: en true, todos los endpoints de ese proveedor responden 503.
SIMULAR_CAIDA_KYC=false
SIMULAR_CAIDA_OPEN_DATA=false
SIMULAR_CAIDA_PAGOS=false

# Latencia simulada de los proveedores, en milisegundos. Los defaults 200/800
# reproducen exactamente el rango del monolito; 0/0 responde sin espera.
SIMULAR_LATENCIA_MIN_MS=200
SIMULAR_LATENCIA_MAX_MS=800

# Experimento EXP-006 (disponibilidad de Cotizacion): habilita POST /simulacion/:proveedor
# para tumbar o volver lento un proveedor en caliente. Solo true durante experimentos.
SIMULACION_ADMIN_HABILITADA=false